# URL de conexión a PostgreSQL (se auto-normaliza de postgres:// a postgresql+psycopg:// en database/config.py)
DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/nombre_db

# Clave secreta para firmar los JWT (HS256). Obligatoria: la app no arranca sin ella.
SECRET_KEY=cadena_larga_y_aleatoria

# API key de OpenAI para el chat (módulo chat/). Obligatoria.
OPENAI_API_KEY=sk-...

# API key de Resend para el envío de códigos de verificación/recuperación. Obligatoria.
RESEND_API_KEY=re_...

# Remitente verificado en Resend.
EMAIL_FROM=onboarding@ezapp.tech

# Entorno de ejecución: "production" deshabilita Swagger/ReDoc/OpenAPI. Por defecto "development".
ENVIRONMENT=development

# (Opcional) DSN de Sentry para error tracking. Vacío = Sentry desactivado (no rompe el arranque local).
SENTRY_DSN=

# (Opcional) Configuración del modelo de OpenAI; valores por defecto si se omiten.
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_TOKENS=400
